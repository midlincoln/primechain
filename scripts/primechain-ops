#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
usage:
  primechain-ops install-validator-service --identity <wallet> --genesis-validator <addr> [options]
  primechain-ops print-validator-service --identity <wallet> --genesis-validator <addr> [options]
  primechain-ops doctor-validator [options]
  primechain-ops doctor-network --validator <host:port> --validator <host:port> ... [options]
  primechain-ops evidence --workdir <client-workdir> --validator <host:port> ... [options]
  primechain-ops launch-summary --workdir <client-workdir> --validator <host:port> ... [options]
  primechain-ops transaction-evidence --workdir <client-workdir> --sender-wallet <wallet> --receiver-wallet <wallet> --prime <p> --amount <micro-units> --target <integer> --validator <host:port> ... [options]
  primechain-ops fee-distribution-status --workdir <client-workdir> [options]
  primechain-ops launch-status-json --workdir <client-workdir> --validator <host:port> ... [options]

install-validator-service options:
  --port <port>                         default: 8339
  --data <chain.dat>                    default: /home/primechain/primechain-launch-data/chain.dat
  --binary <primechain-sync-server>     default: <repo>/build/primechain-sync-server
  --identity <wallet>                   required
  --genesis-validator <addr>            required
  --bootstrap <host:port>               optional bootstrap peer
  --bind <address>                      default: 0.0.0.0
  --env-file <path>                     default: /home/primechain/primechain-wallet.env
  --working-dir <path>                  default: <repo>
  --unit <name>                         default: primechain-launch-node
  --user <user>                         default: primechain
  --finalization-timeout-ms <ms>        default: 5000
  --client <primechain-client>          default: <repo>/build/primechain-client
  --ready-timeout-sec <seconds>         default: 20
  --no-chain-endpoints                  disable on-chain endpoint peer discovery
  --dry-run                             print the unit, do not write or restart systemd
  --no-restart                          write unit but do not restart/enable it

doctor-validator options:
  --host <host>                         default: 127.0.0.1
  --port <port>                         default: 8339
  --binary <primechain-sync-server>     default: <repo>/build/primechain-sync-server
  --client <primechain-client>          default: <repo>/build/primechain-client
  --identity <wallet>                   optional wallet path check
  --unit <name>                         default: primechain-launch-node

doctor-network options:
  --validator <host:port>               repeat once per validator
  --client <primechain-client>          default: <repo>/build/primechain-client

evidence options:
  --workdir <client-workdir>            required; contains data/chain.dat and peer config
  --validator <host:port>               repeat once per validator
  --client <primechain-client>          default: <repo>/build/primechain-client
  --output <file>                       optional report file path
  --out-dir <dir>                       default: <workdir>/reports

launch-summary options:
  --workdir <client-workdir>            required; contains data/chain.dat and peer config
  --validator <host:port>               repeat once per validator
  --client <primechain-client>          default: <repo>/build/primechain-client
  --output <file>                       optional summary file path
  --out-dir <dir>                       default: <workdir>/reports

transaction-evidence options:
  --workdir <client-workdir>            required; contains data/chain.dat and peer config
  --sender-wallet <wallet>              required sender wallet
  --receiver-wallet <wallet>            required receiver wallet; created if missing
  --prime <p>                           required prime asset to transfer
  --amount <micro-units>                required transfer amount
  --fee <micro-units>                   default: active policy fee from launch-report
  --nonce <n|auto>                      default: auto from first validator
  --target <integer>                    required mine target after submitting transaction
  --validator <host:port>               repeat once per validator
  --client <primechain-client>          default: <repo>/build/primechain-client
  --send <primechain-send>              default: <repo>/build/primechain-send
  --output <file>                       optional transaction evidence file path
  --out-dir <dir>                       default: <workdir>/reports

fee-distribution-status options:
  --workdir <client-workdir>            required; contains data/chain.dat and peer config
  --interval-records <count>            default: 1000
  --client <primechain-client>          default: <repo>/build/primechain-client

launch-status-json options:
  --workdir <client-workdir>            required; contains data/chain.dat and peer config
  --validator <host:port>               repeat once per validator
  --interval-records <count>            default: 1000
  --client <primechain-client>          default: <repo>/build/primechain-client
  --output <file>                       optional JSON output path
USAGE
}

die() {
  echo "ERROR $*" >&2
  exit 1
}

have() {
  command -v "$1" >/dev/null 2>&1
}

require_value() {
  local flag="$1"
  local value="${2:-}"
  [ -n "$value" ] || die "$flag requires a value"
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

default_port=8339
default_data=/home/primechain/primechain-launch-data/chain.dat
default_binary="$repo_root/build/primechain-sync-server"
default_client="$repo_root/build/primechain-client"
default_env_file=/home/primechain/primechain-wallet.env
default_working_dir="$repo_root"
default_unit=primechain-launch-node
default_user=primechain
default_bind=0.0.0.0
default_timeout=5000

render_unit() {
  local unit_user="$1"
  local working_dir="$2"
  local env_file="$3"
  local binary="$4"
  local port="$5"
  local data="$6"
  local bind_addr="$7"
  local bootstrap="$8"
  local genesis_validator="$9"
  local identity="${10}"
  local finalization_timeout_ms="${11}"
  local use_chain_endpoints="${12}"

  local exec_start=("$binary" "$port" "$data" --bind "$bind_addr")
  if [ -n "$bootstrap" ]; then
    local bootstrap_host="${bootstrap%:*}"
    local bootstrap_port="${bootstrap##*:}"
    [ "$bootstrap_host" != "$bootstrap" ] || die "--bootstrap must be host:port"
    [ -n "$bootstrap_host" ] || die "--bootstrap host is empty"
    [ -n "$bootstrap_port" ] || die "--bootstrap port is empty"
    exec_start+=(--bootstrap-peer "$bootstrap_host" "$bootstrap_port")
  fi
  exec_start+=(--genesis-validator-set "$genesis_validator")
  exec_start+=(--validator-identity "$identity")
  if [ "$use_chain_endpoints" = "1" ]; then
    exec_start+=(--use-chain-endpoints)
  fi
  exec_start+=(--finalization-timeout-ms "$finalization_timeout_ms")

  cat <<UNIT
[Unit]
Description=Primechain launch validator node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$unit_user
WorkingDirectory=$working_dir
EnvironmentFile=$env_file
ExecStart=${exec_start[*]}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
UNIT
}

check_binary_flags() {
  local binary="$1"
  [ -x "$binary" ] || die "sync server binary is not executable: $binary"
  local help
  help="$("$binary" --help 2>&1 || true)"
  echo "$help" | grep -q -- "--genesis-validator-set" || die "binary does not support --genesis-validator-set: $binary"
  echo "$help" | grep -q -- "--bootstrap-peer" || die "binary does not support --bootstrap-peer: $binary"
  echo "$help" | grep -q -- "--use-chain-endpoints" || die "binary does not support --use-chain-endpoints: $binary"
}

wait_for_node_ready() {
  local client="$1"
  local host="$2"
  local port="$3"
  local timeout_sec="$4"
  local start
  start="$(date +%s)"

  [ -x "$client" ] || die "client is not executable: $client"

  while true; do
    if "$client" status "$host" "$port" >/tmp/primechain-ops-ready.out 2>/tmp/primechain-ops-ready.err; then
      echo "READY node-status $(cat /tmp/primechain-ops-ready.out)"
      rm -f /tmp/primechain-ops-ready.out /tmp/primechain-ops-ready.err
      return 0
    fi

    local now
    now="$(date +%s)"
    if [ $((now - start)) -ge "$timeout_sec" ]; then
      echo "ERROR node did not become ready within ${timeout_sec}s at ${host}:${port}" >&2
      sed 's/^/  /' /tmp/primechain-ops-ready.err >&2 || true
      rm -f /tmp/primechain-ops-ready.out /tmp/primechain-ops-ready.err
      return 1
    fi
    sleep 1
  done
}

cmd_install_or_print() {
  local mode="$1"
  shift

  local port="$default_port"
  local data="$default_data"
  local binary="$default_binary"
  local client="$default_client"
  local identity=""
  local genesis_validator=""
  local bootstrap=""
  local bind_addr="$default_bind"
  local env_file="$default_env_file"
  local working_dir="$default_working_dir"
  local unit="$default_unit"
  local unit_user="$default_user"
  local finalization_timeout_ms="$default_timeout"
  local use_chain_endpoints=1
  local dry_run=0
  local no_restart=0
  local ready_timeout_sec=20

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --port) require_value "$1" "${2:-}"; port="$2"; shift 2 ;;
      --data) require_value "$1" "${2:-}"; data="$2"; shift 2 ;;
      --binary) require_value "$1" "${2:-}"; binary="$2"; shift 2 ;;
      --client) require_value "$1" "${2:-}"; client="$2"; shift 2 ;;
      --identity) require_value "$1" "${2:-}"; identity="$2"; shift 2 ;;
      --genesis-validator) require_value "$1" "${2:-}"; genesis_validator="$2"; shift 2 ;;
      --bootstrap) require_value "$1" "${2:-}"; bootstrap="$2"; shift 2 ;;
      --bind) require_value "$1" "${2:-}"; bind_addr="$2"; shift 2 ;;
      --env-file) require_value "$1" "${2:-}"; env_file="$2"; shift 2 ;;
      --working-dir) require_value "$1" "${2:-}"; working_dir="$2"; shift 2 ;;
      --unit) require_value "$1" "${2:-}"; unit="$2"; shift 2 ;;
      --user) require_value "$1" "${2:-}"; unit_user="$2"; shift 2 ;;
      --finalization-timeout-ms) require_value "$1" "${2:-}"; finalization_timeout_ms="$2"; shift 2 ;;
      --ready-timeout-sec) require_value "$1" "${2:-}"; ready_timeout_sec="$2"; shift 2 ;;
      --no-chain-endpoints) use_chain_endpoints=0; shift ;;
      --dry-run) dry_run=1; shift ;;
      --no-restart) no_restart=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option: $1" ;;
    esac
  done

  [ -n "$identity" ] || die "--identity is required"
  [ -n "$genesis_validator" ] || die "--genesis-validator is required"
  [ -f "$identity" ] || die "identity wallet not found: $identity"
  [ -d "$working_dir" ] || die "working directory not found: $working_dir"
  [ -f "$env_file" ] || die "environment file not found: $env_file"
  check_binary_flags "$binary"

  local unit_text
  unit_text="$(render_unit "$unit_user" "$working_dir" "$env_file" "$binary" "$port" "$data" "$bind_addr" "$bootstrap" "$genesis_validator" "$identity" "$finalization_timeout_ms" "$use_chain_endpoints")"

  if [ "$mode" = "print" ] || [ "$dry_run" -eq 1 ]; then
    printf '%s\n' "$unit_text"
    exit 0
  fi

  [ "$no_restart" -eq 1 ] || [ -x "$client" ] || die "client is not executable: $client"
  [ "$(id -u)" -eq 0 ] || die "install-validator-service must run as root; use sudo"
  mkdir -p "$(dirname "$data")"
  have systemctl || die "systemctl not found"

  local service_path="/etc/systemd/system/${unit}.service"
  local tmp
  tmp="$(mktemp)"
  printf '%s\n' "$unit_text" > "$tmp"
  install -m 0644 "$tmp" "$service_path"
  rm -f "$tmp"

  systemctl daemon-reload
  if [ "$no_restart" -eq 0 ]; then
    systemctl enable --now "$unit"
    systemctl restart "$unit"
    wait_for_node_ready "$client" 127.0.0.1 "$port" "$ready_timeout_sec"
    systemctl --no-pager -l status "$unit"
  else
    echo "UNIT_WRITTEN $service_path"
  fi
}

cmd_doctor() {
  local host=127.0.0.1
  local port="$default_port"
  local binary="$default_binary"
  local client="$default_client"
  local identity=""
  local unit="$default_unit"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --host) require_value "$1" "${2:-}"; host="$2"; shift 2 ;;
      --port) require_value "$1" "${2:-}"; port="$2"; shift 2 ;;
      --binary) require_value "$1" "${2:-}"; binary="$2"; shift 2 ;;
      --client) require_value "$1" "${2:-}"; client="$2"; shift 2 ;;
      --identity) require_value "$1" "${2:-}"; identity="$2"; shift 2 ;;
      --unit) require_value "$1" "${2:-}"; unit="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option: $1" ;;
    esac
  done

  local failed=0

  check() {
    local label="$1"
    shift
    if "$@" >/tmp/primechain-ops-check.out 2>/tmp/primechain-ops-check.err; then
      echo "OK $label"
    else
      echo "FAIL $label"
      sed 's/^/  /' /tmp/primechain-ops-check.err >&2 || true
      failed=1
    fi
  }

  check "sync-server-flags" check_binary_flags "$binary"
  check "client-executable" test -x "$client"
  if [ -n "$identity" ]; then
    check "identity-wallet" test -f "$identity"
  fi
  if have systemctl; then
    check "service-enabled" systemctl is-enabled "$unit"
    check "service-active" systemctl is-active "$unit"
  else
    echo "SKIP systemctl not found"
  fi
  if have ss; then
    if ss -ltn | grep -q ":$port "; then
      echo "OK port-listening $port"
    else
      echo "FAIL port-listening $port"
      failed=1
    fi
  else
    echo "SKIP ss not found"
  fi
  check "node-status" "$client" status "$host" "$port"
  check "validators-query" "$client" query "$host" "$port" GET_VALIDATORS
  check "validator-epoch-query" "$client" query "$host" "$port" GET_VALIDATOR_EPOCH
  check "validator-endpoints-query" "$client" query "$host" "$port" GET_VALIDATOR_ENDPOINTS
  check "peers-query" "$client" query "$host" "$port" GET_PEERS

  rm -f /tmp/primechain-ops-check.out /tmp/primechain-ops-check.err
  [ "$failed" -eq 0 ] || return 1
}


cmd_doctor_network() {
  local client="$default_client"
  local validators=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --validator) require_value "$1" "${2:-}"; validators+=("$2"); shift 2 ;;
      --client) require_value "$1" "${2:-}"; client="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option: $1" ;;
    esac
  done

  [ "${#validators[@]}" -gt 0 ] || die "at least one --validator host:port is required"
  [ -x "$client" ] || die "client is not executable: $client"

  local expected_frontier=""
  local expected_hash=""
  local expected_validators=""
  local expected_epoch=""
  local expected_endpoints=""
  local failed=0

  local node
  for node in "${validators[@]}"; do
    local host="${node%:*}"
    local port="${node##*:}"
    if [ "$host" = "$node" ] || [ -z "$host" ] || [ -z "$port" ]; then
      echo "FAIL invalid-validator $node" >&2
      failed=1
      continue
    fi

    local status validators_out epoch_out endpoints_out peers_out
    if ! status="$($client status "$host" "$port" 2>&1)"; then
      echo "FAIL status $node"
      echo "  $status" >&2
      failed=1
      continue
    fi
    if ! validators_out="$($client query "$host" "$port" GET_VALIDATORS 2>&1)"; then
      echo "FAIL validators $node"
      echo "  $validators_out" >&2
      failed=1
      continue
    fi
    if ! epoch_out="$($client query "$host" "$port" GET_VALIDATOR_EPOCH 2>&1)"; then
      echo "FAIL validator-epoch $node"
      echo "  $epoch_out" >&2
      failed=1
      continue
    fi
    if ! endpoints_out="$($client query "$host" "$port" GET_VALIDATOR_ENDPOINTS 2>&1)"; then
      echo "FAIL validator-endpoints $node"
      echo "  $endpoints_out" >&2
      failed=1
      continue
    fi
    if ! peers_out="$($client query "$host" "$port" GET_PEERS 2>&1)"; then
      echo "FAIL peers $node"
      echo "  $peers_out" >&2
      failed=1
      continue
    fi

    local frontier hash
    frontier="$(echo "$status" | awk '{print $7}')"
    hash="$(echo "$status" | awk '{print $8}')"
    echo "NODE $node frontier=$frontier hash=$hash"

    if [ -z "$expected_frontier" ]; then
      expected_frontier="$frontier"
      expected_hash="$hash"
      expected_validators="$validators_out"
      expected_epoch="$epoch_out"
      expected_endpoints="$endpoints_out"
    else
      if [ "$frontier" != "$expected_frontier" ] || [ "$hash" != "$expected_hash" ]; then
        echo "FAIL chain-disagreement $node expected_frontier=$expected_frontier expected_hash=$expected_hash got_frontier=$frontier got_hash=$hash"
        failed=1
      fi
      if [ "$validators_out" != "$expected_validators" ]; then
        echo "FAIL validator-set-disagreement $node"
        failed=1
      fi
      if [ "$epoch_out" != "$expected_epoch" ]; then
        echo "FAIL validator-epoch-disagreement $node"
        failed=1
      fi
      if [ "$endpoints_out" != "$expected_endpoints" ]; then
        echo "FAIL validator-endpoints-disagreement $node"
        failed=1
      fi
    fi

    local other other_host other_port
    for other in "${validators[@]}"; do
      [ "$other" != "$node" ] || continue
      other_host="${other%:*}"
      other_port="${other##*:}"
      if echo "$peers_out" | grep -q "^PEER ${other_host} ${other_port}$"; then
        echo "OK peer $node -> $other"
      else
        echo "FAIL missing-peer $node -> $other"
        failed=1
      fi
      if echo "$endpoints_out" | grep -q " ${other_host} ${other_port} "; then
        echo "OK endpoint-visible $other"
      else
        echo "FAIL endpoint-missing $other from $node"
        failed=1
      fi
    done
  done

  if [ "$failed" -eq 0 ]; then
    echo "NETWORK_OK validators=${#validators[@]} frontier=$expected_frontier hash=$expected_hash"
  fi
  [ "$failed" -eq 0 ] || return 1
}


cmd_evidence() {
  local client="$default_client"
  local workdir=""
  local output=""
  local out_dir=""
  local validators=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --workdir) require_value "$1" "${2:-}"; workdir="$2"; shift 2 ;;
      --validator) require_value "$1" "${2:-}"; validators+=("$2"); shift 2 ;;
      --client) require_value "$1" "${2:-}"; client="$2"; shift 2 ;;
      --output) require_value "$1" "${2:-}"; output="$2"; shift 2 ;;
      --out-dir) require_value "$1" "${2:-}"; out_dir="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option: $1" ;;
    esac
  done

  [ -n "$workdir" ] || die "--workdir is required"
  [ "${#validators[@]}" -gt 0 ] || die "at least one --validator host:port is required"
  [ -x "$client" ] || die "client is not executable: $client"
  [ -d "$workdir" ] || die "workdir not found: $workdir"

  local chain="$workdir/data/chain.dat"
  [ -n "$out_dir" ] || out_dir="$workdir/reports"
  if [ -z "$output" ]; then
    mkdir -p "$out_dir"
    output="$out_dir/launch-evidence-$(date -u +%Y%m%dT%H%M%SZ).txt"
  else
    mkdir -p "$(dirname "$output")"
  fi

  local failed=0
  {
    echo "PRIMECHAIN_EVIDENCE generated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "WORKDIR $workdir"
    echo "CLIENT $client"
    echo "VALIDATORS ${validators[*]}"
    echo
    echo "COMMAND sync-peer"
    if "$client" sync-peer "$workdir"; then
      echo "RESULT sync-peer OK"
    else
      rc=$?
      echo "RESULT sync-peer FAIL rc=$rc"
      failed=1
    fi
    echo
    echo "COMMAND launch-report"
    if [ -f "$chain" ] && "$client" launch-report "$chain"; then
      echo "RESULT launch-report OK"
    else
      rc=$?
      echo "RESULT launch-report FAIL rc=$rc"
      failed=1
    fi
    echo
    echo "COMMAND doctor-network"
    local doctor_args=(--client "$client")
    local validator
    for validator in "${validators[@]}"; do
      doctor_args+=(--validator "$validator")
    done
    if cmd_doctor_network "${doctor_args[@]}"; then
      echo "RESULT doctor-network OK"
    else
      rc=$?
      echo "RESULT doctor-network FAIL rc=$rc"
      failed=1
    fi
  } > "$output" 2>&1

  cat "$output"
  echo "EVIDENCE_REPORT $output"
  [ "$failed" -eq 0 ] || exit 1
}



parse_node() {
  local node="$1"
  local __host_var="$2"
  local __port_var="$3"
  local host="${node%:*}"
  local port="${node##*:}"
  [ "$host" != "$node" ] || die "invalid host:port: $node"
  [ -n "$host" ] || die "host is empty: $node"
  [ -n "$port" ] || die "port is empty: $node"
  printf -v "$__host_var" '%s' "$host"
  printf -v "$__port_var" '%s' "$port"
}

balance_for_prime() {
  local balance_file="$1"
  local prime="$2"
  awk -v p="$prime" '$1 == p { print $2; found=1 } END { if (!found) print 0 }' "$balance_file"
}

fee_pool_for_prime() {
  local pool_file="$1"
  local prime="$2"
  awk -v p="$prime" '$1 == "FEE_POOL_HOLDING" { for (i=1; i<=NF; ++i) { if ($i == "prime=" p) prime_seen=1; if ($i ~ /^micro_units=/) { split($i, a, "="); amount=a[2]; } } if (prime_seen) { print amount; found=1 } prime_seen=0; amount=0 } END { if (!found) print 0 }' "$pool_file"
}

field_value() {
  local line="$1"
  local field="$2"
  awk -v key="$field" '{ for (i=1; i<=NF; ++i) { split($i, a, "="); if (a[1] == key) { print a[2]; exit } } }' <<<"$line"
}

mempool_count() {
  local mempool_file="$1"
  awk '$1 == "MEMPOOL" { print $2; found=1; exit } END { if (!found) print 0 }' "$mempool_file"
}


json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  printf '%s' "$value"
}

json_string() {
  printf '"%s"' "$(json_escape "$1")"
}


cmd_fee_distribution_status() {
  local client="$default_client"
  local workdir=""
  local interval_records=1000

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --workdir) require_value "$1" "${2:-}"; workdir="$2"; shift 2 ;;
      --interval-records) require_value "$1" "${2:-}"; interval_records="$2"; shift 2 ;;
      --client) require_value "$1" "${2:-}"; client="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option: $1" ;;
    esac
  done

  [ -n "$workdir" ] || die "--workdir is required"
  [ -x "$client" ] || die "client is not executable: $client"
  [ -d "$workdir" ] || die "workdir not found: $workdir"
  local chain="$workdir/data/chain.dat"
  [ -f "$chain" ] || die "record store not found: $chain"

  "$client" sync-peer "$workdir" >/dev/null
  "$client" fee-distribution-status "$chain" "$interval_records"
}


cmd_launch_status_json() {
  local client="$default_client"
  local workdir=""
  local interval_records=1000
  local output=""
  local validators=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --workdir) require_value "$1" "${2:-}"; workdir="$2"; shift 2 ;;
      --validator) require_value "$1" "${2:-}"; validators+=("$2"); shift 2 ;;
      --interval-records) require_value "$1" "${2:-}"; interval_records="$2"; shift 2 ;;
      --client) require_value "$1" "${2:-}"; client="$2"; shift 2 ;;
      --output) require_value "$1" "${2:-}"; output="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option: $1" ;;
    esac
  done

  [ -n "$workdir" ] || die "--workdir is required"
  [ "${#validators[@]}" -gt 0 ] || die "at least one --validator host:port is required"
  [ -x "$client" ] || die "client is not executable: $client"
  [ -d "$workdir" ] || die "workdir not found: $workdir"
  local chain="$workdir/data/chain.dat"
  [ -f "$chain" ] || die "record store not found: $chain"

  local tmpdir
  tmpdir="$(mktemp -d)"
  local summary_file="$tmpdir/summary.txt"
  local fee_file="$tmpdir/fee.txt"

  local summary_args=(--client "$client" --workdir "$workdir" --output "$summary_file")
  local validator
  for validator in "${validators[@]}"; do
    summary_args+=(--validator "$validator")
  done
  cmd_launch_summary "${summary_args[@]}" >/dev/null
  cmd_fee_distribution_status --client "$client" --workdir "$workdir" --interval-records "$interval_records" > "$fee_file"

  local generated_at network_line chain_line validator_state evidence_summary economics_line board_line fee_line last_fee_line event_line
  generated_at="$(awk '/^PRIMECHAIN_LAUNCH_SUMMARY / { for (i=1; i<=NF; ++i) { split($i,a,"="); if (a[1] == "generated_at") { print a[2]; exit } } }' "$summary_file")"
  network_line="$(grep '^NETWORK ' "$summary_file")"
  chain_line="$(grep '^CHAIN ' "$summary_file")"
  validator_state="$(grep '^VALIDATOR_STATE ' "$summary_file")"
  evidence_summary="$(grep '^VALIDATOR_EVIDENCE_SUMMARY ' "$summary_file")"
  economics_line="$(grep '^ECONOMICS ' "$summary_file")"
  board_line="$(grep '^BOARD ' "$summary_file")"
  fee_line="$(grep '^FEE_DISTRIBUTION_STATUS ' "$fee_file")"
  last_fee_line="$(grep '^LAST_FEE_DISTRIBUTION ' "$fee_file" || true)"
  event_line="$(grep '^FEE_DISTRIBUTION_EVENT ' "$fee_file" | tail -1 || true)"

  [ -n "$output" ] || output="$workdir/reports/launch-status.json"
  mkdir -p "$(dirname "$output")"

  {
    echo "{"
    printf '  "generated_at": '; json_string "$generated_at"; echo ","
    printf '  "workdir": '; json_string "$workdir"; echo ","
    echo "  \"network\": {"
    echo "    \"validators\": $(field_value "$network_line" validators),"
    printf '    "frontier": %s,\n' "$(field_value "$network_line" frontier)"
    printf '    "hash": '; json_string "$(field_value "$network_line" hash)"; echo
    echo "  },"
    echo "  \"chain\": {"
    printf '    "height": %s,\n' "$(field_value "$chain_line" height)"
    printf '    "frontier": %s,\n' "$(field_value "$chain_line" frontier)"
    printf '    "latest_hash": '; json_string "$(field_value "$chain_line" latest_hash)"; echo ","
    printf '    "records": %s,\n' "$(field_value "$chain_line" records)"
    printf '    "prime_records": %s,\n' "$(field_value "$chain_line" prime_records)"
    printf '    "composite_records": %s,\n' "$(field_value "$chain_line" composite_records)"
    printf '    "transactions": %s\n' "$(field_value "$chain_line" transactions)"
    echo "  },"
    echo "  \"validator_state\": {"
    printf '    "epoch": %s,\n' "$(field_value "$validator_state" epoch)"
    printf '    "active_validators": %s,\n' "$(field_value "$validator_state" active_validators)"
    printf '    "registry_events": %s,\n' "$(field_value "$validator_state" registry_events)"
    printf '    "endpoint_events": %s,\n' "$(field_value "$validator_state" endpoint_events)"
    printf '    "active_endpoints": %s,\n' "$(field_value "$validator_state" active_endpoints)"
    printf '    "transfer_fee_micro_units": %s\n' "$(field_value "$validator_state" transfer_fee_micro_units)"
    echo "  },"
    echo "  \"validator_evidence_summary\": {"
    printf '    "active": %s,\n' "$(field_value "$evidence_summary" active)"
    printf '    "historical": %s,\n' "$(field_value "$evidence_summary" historical)"
    printf '    "bootstrap_dev": %s\n' "$(field_value "$evidence_summary" bootstrap_dev)"
    echo "  },"
    echo "  \"economics\": {"
    printf '    "active_transfer_fee_micro_units": %s,\n' "$(field_value "$economics_line" active_transfer_fee_micro_units)"
    printf '    "fee_pool_epoch": %s,\n' "$(field_value "$economics_line" epoch)"
    printf '    "fee_pool_address": '; json_string "$(field_value "$economics_line" address)"; echo ","
    printf '    "fee_pool_holdings": %s,\n' "$(field_value "$economics_line" holdings)"
    printf '    "fee_pool_total_micro_units": %s\n' "$(field_value "$economics_line" total_micro_units)"
    echo "  },"
    echo "  \"board\": {"
    printf '    "records": %s,\n' "$(field_value "$board_line" records)"
    printf '    "prime": %s,\n' "$(field_value "$board_line" prime)"
    printf '    "composite": %s,\n' "$(field_value "$board_line" composite)"
    printf '    "transactions": %s,\n' "$(field_value "$board_line" transactions)"
    printf '    "discovery_micro_units": %s,\n' "$(field_value "$board_line" discovery_micro_units)"
    printf '    "fee_micro_units": %s,\n' "$(field_value "$board_line" fee_micro_units)"
    printf '    "unique_miners": %s,\n' "$(field_value "$board_line" unique_miners)"
    printf '    "pending_composites_after_range": %s\n' "$(field_value "$board_line" pending_composites_after_range)"
    echo "  },"
    echo "  \"fee_distribution\": {"
    printf '    "interval_records": %s,\n' "$(field_value "$fee_line" interval_records)"
    printf '    "current_frontier": %s,\n' "$(field_value "$fee_line" current_frontier)"
    printf '    "last_distribution_integer": %s,\n' "$(field_value "$fee_line" last_distribution_integer)"
    printf '    "next_distribution_integer": %s,\n' "$(field_value "$fee_line" next_distribution_integer)"
    printf '    "due": %s,\n' "$(field_value "$fee_line" due)"
    printf '    "current_epoch": %s,\n' "$(field_value "$fee_line" current_epoch)"
    printf '    "pool_address": '; json_string "$(field_value "$fee_line" pool_address)"; echo ","
    printf '    "pool_holdings": %s,\n' "$(field_value "$fee_line" pool_holdings)"
    printf '    "pool_total_micro_units": %s,\n' "$(field_value "$fee_line" pool_total_micro_units)"
    printf '    "distributions": %s' "$(field_value "$fee_line" distributions)"
    if [ -n "$last_fee_line" ]; then
      echo ","
      echo "    \"last\": {"
      printf '      "integer": %s,\n' "$(field_value "$last_fee_line" integer)"
      printf '      "epoch": %s,\n' "$(field_value "$last_fee_line" epoch)"
      printf '      "prime": %s,\n' "$(field_value "$last_fee_line" prime)"
      printf '      "micro_units": %s\n' "$(field_value "$last_fee_line" micro_units)"
      printf '    }'
    fi
    if [ -n "$event_line" ]; then
      echo ","
      echo "    \"last_event\": {"
      printf '      "integer": %s,\n' "$(field_value "$event_line" integer)"
      printf '      "epoch": %s,\n' "$(field_value "$event_line" epoch)"
      printf '      "prime": %s,\n' "$(field_value "$event_line" prime)"
      printf '      "micro_units": %s,\n' "$(field_value "$event_line" micro_units)"
      printf '      "recipients": %s\n' "$(field_value "$event_line" recipients)"
      printf '    }'
    fi
    echo
    echo "  },"
    echo "  \"validators\": ["
    local first=1 line address
    while IFS= read -r line; do
      address="$(awk '{print $2}' <<<"$line")"
      [ "$first" -eq 1 ] || echo ","
      first=0
      echo "    {"
      printf '      "address": '; json_string "$address"; echo ","
      printf '      "admission": '; json_string "$(field_value "$line" admission)"; echo ","
      printf '      "holdings": %s,\n' "$(field_value "$line" holdings)"
      printf '      "total_micro_units": %s,\n' "$(field_value "$line" total_micro_units)"
      printf '      "host": '; json_string "$(field_value "$line" host)"; echo ","
      printf '      "port": %s,\n' "$(field_value "$line" port)"
      printf '      "effective_integer": %s,\n' "$(field_value "$line" effective_integer)"
      printf '      "sequence": %s,\n' "$(field_value "$line" sequence)"
      printf '      "class": '; json_string "$(field_value "$line" class)"; echo ","
      printf '      "finalization_votes": %s,\n' "$(field_value "$line" finalization_votes)"
      printf '      "commit_phase_votes": %s,\n' "$(field_value "$line" commit_phase_votes)"
      printf '      "round_change_votes": %s\n' "$(field_value "$line" round_change_votes)"
      printf '    }'
    done < <(grep '^VALIDATOR ' "$summary_file")
    echo
    echo "  ]"
    echo "}"
  } > "$output"

  cat "$output"
  echo "LAUNCH_STATUS_JSON $output"
  rm -rf "$tmpdir"
}

cmd_transaction_evidence() {
  local client="$default_client"
  local send="$repo_root/build/primechain-send"
  local workdir=""
  local sender_wallet=""
  local receiver_wallet=""
  local prime=""
  local amount=""
  local fee=""
  local nonce="auto"
  local target=""
  local output=""
  local out_dir=""
  local validators=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --workdir) require_value "$1" "${2:-}"; workdir="$2"; shift 2 ;;
      --sender-wallet) require_value "$1" "${2:-}"; sender_wallet="$2"; shift 2 ;;
      --receiver-wallet) require_value "$1" "${2:-}"; receiver_wallet="$2"; shift 2 ;;
      --prime) require_value "$1" "${2:-}"; prime="$2"; shift 2 ;;
      --amount) require_value "$1" "${2:-}"; amount="$2"; shift 2 ;;
      --fee) require_value "$1" "${2:-}"; fee="$2"; shift 2 ;;
      --nonce) require_value "$1" "${2:-}"; nonce="$2"; shift 2 ;;
      --target) require_value "$1" "${2:-}"; target="$2"; shift 2 ;;
      --validator) require_value "$1" "${2:-}"; validators+=("$2"); shift 2 ;;
      --client) require_value "$1" "${2:-}"; client="$2"; shift 2 ;;
      --send) require_value "$1" "${2:-}"; send="$2"; shift 2 ;;
      --output) require_value "$1" "${2:-}"; output="$2"; shift 2 ;;
      --out-dir) require_value "$1" "${2:-}"; out_dir="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option: $1" ;;
    esac
  done

  [ -n "$workdir" ] || die "--workdir is required"
  [ -n "$sender_wallet" ] || die "--sender-wallet is required"
  [ -n "$receiver_wallet" ] || die "--receiver-wallet is required"
  [ -n "$prime" ] || die "--prime is required"
  [ -n "$amount" ] || die "--amount is required"
  [ -n "$target" ] || die "--target is required"
  [ "${#validators[@]}" -gt 0 ] || die "at least one --validator host:port is required"
  [ -x "$client" ] || die "client is not executable: $client"
  [ -x "$send" ] || die "send executable is not executable: $send"
  [ -d "$workdir" ] || die "workdir not found: $workdir"
  [ -f "$sender_wallet" ] || die "sender wallet not found: $sender_wallet"
  if [ ! -f "$receiver_wallet" ]; then
    "$client" new-miner "$receiver_wallet" >/dev/null
  fi

  local chain="$workdir/data/chain.dat"
  [ -f "$chain" ] || die "record store not found: $chain"
  [ -n "$out_dir" ] || out_dir="$workdir/reports"
  if [ -z "$output" ]; then
    mkdir -p "$out_dir"
    output="$out_dir/transaction-evidence-$(date -u +%Y%m%dT%H%M%SZ).txt"
  else
    mkdir -p "$(dirname "$output")"
  fi

  local primary_host primary_port
  parse_node "${validators[0]}" primary_host primary_port

  local tmpdir
  tmpdir="$(mktemp -d)"

  "$client" sync-peer "$workdir" >"$tmpdir/sync-before.out"
  "$client" launch-report "$chain" >"$tmpdir/launch-before.out"
  if [ -z "$fee" ]; then
    fee="$(field_value "$(grep '^ECONOMIC_POLICY ' "$tmpdir/launch-before.out")" active_transfer_fee_micro_units)"
  fi
  [ -n "$fee" ] || { rm -rf "$tmpdir"; die "could not determine transfer fee"; }

  local current_frontier
  current_frontier="$(field_value "$(grep '^CHAIN ' "$tmpdir/launch-before.out")" frontier)"
  [ -n "$current_frontier" ] || { rm -rf "$tmpdir"; die "could not determine current frontier"; }
  if [ "$target" -le "$current_frontier" ]; then
    rm -rf "$tmpdir"
    die "--target must be greater than current frontier; target=$target frontier=$current_frontier"
  fi

  "$client" query "$primary_host" "$primary_port" GET_MEMPOOL >"$tmpdir/mempool-before.out"
  local pending_count
  pending_count="$(mempool_count "$tmpdir/mempool-before.out")"
  if [ "$pending_count" -ne 0 ]; then
    cat "$tmpdir/mempool-before.out" >&2
    rm -rf "$tmpdir"
    die "mempool is not empty; mine or clear pending transactions before transaction-evidence"
  fi

  local sender_address receiver_address
  sender_address="$($client address "$sender_wallet")"
  receiver_address="$($client address "$receiver_wallet")"

  if [ "$nonce" = "auto" ]; then
    local nonce_line
    nonce_line="$($client query "$primary_host" "$primary_port" GET_NONCE "$sender_address")"
    nonce="$(echo "$nonce_line" | awk '{print $4}')"
  fi
  [ -n "$nonce" ] || die "could not determine nonce"

  "$client" balance "$chain" "$sender_wallet" >"$tmpdir/sender-before.out"
  "$client" balance "$chain" "$receiver_wallet" >"$tmpdir/receiver-before.out"
  "$client" fee-pool "$chain" >"$tmpdir/pool-before.out"

  local sender_before receiver_before pool_before
  sender_before="$(balance_for_prime "$tmpdir/sender-before.out" "$prime")"
  receiver_before="$(balance_for_prime "$tmpdir/receiver-before.out" "$prime")"
  pool_before="$(fee_pool_for_prime "$tmpdir/pool-before.out" "$prime")"
  if [ "$sender_before" -lt $((amount + fee)) ]; then
    rm -rf "$tmpdir"
    die "insufficient sender balance for prime $prime: balance=$sender_before required=$((amount + fee))"
  fi

  "$send" submit "$primary_host" "$primary_port" "$sender_wallet" "$receiver_address" "$prime" "$amount" "$fee" "$nonce" >"$tmpdir/submit.out"
  grep -q '^TX_ACCEPTED ' "$tmpdir/submit.out" || {
    cat "$tmpdir/submit.out" >&2
    rm -rf "$tmpdir"
    die "transaction was not accepted"
  }

  "$client" add-mine-job "$workdir" --target "$target" >"$tmpdir/add-job.out"
  "$client" run-jobs "$workdir" >"$tmpdir/mine.out"
  "$client" sync-peer "$workdir" >"$tmpdir/sync-after.out"
  "$client" balance "$chain" "$sender_wallet" >"$tmpdir/sender-after.out"
  "$client" balance "$chain" "$receiver_wallet" >"$tmpdir/receiver-after.out"
  "$client" fee-pool "$chain" >"$tmpdir/pool-after.out"
  "$client" launch-report "$chain" >"$tmpdir/launch-after.out"

  local doctor_args=(--client "$client")
  local validator
  for validator in "${validators[@]}"; do
    doctor_args+=(--validator "$validator")
  done
  cmd_doctor_network "${doctor_args[@]}" >"$tmpdir/doctor.out"

  local sender_after receiver_after pool_after expected_sender expected_receiver expected_pool tx_hash network_line chain_line board_line
  sender_after="$(balance_for_prime "$tmpdir/sender-after.out" "$prime")"
  receiver_after="$(balance_for_prime "$tmpdir/receiver-after.out" "$prime")"
  pool_after="$(fee_pool_for_prime "$tmpdir/pool-after.out" "$prime")"
  expected_sender=$((sender_before - amount - fee))
  expected_receiver=$((receiver_before + amount))
  expected_pool=$((pool_before + fee))
  tx_hash="$(awk '/^TX_ACCEPTED / { print $2; exit }' "$tmpdir/submit.out")"
  network_line="$(grep '^NETWORK_OK ' "$tmpdir/doctor.out")"
  chain_line="$(grep '^CHAIN ' "$tmpdir/launch-after.out")"
  board_line="$(grep '^BOARD ' "$tmpdir/launch-after.out")"

  local pass=1
  [ "$sender_after" -eq "$expected_sender" ] || pass=0
  [ "$receiver_after" -eq "$expected_receiver" ] || pass=0
  [ "$pool_after" -eq "$expected_pool" ] || pass=0

  {
    echo "PRIMECHAIN_TRANSACTION_EVIDENCE generated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "WORKDIR $workdir"
    echo "NETWORK ${network_line#NETWORK_OK }"
    echo "CHAIN ${chain_line#CHAIN }"
    echo "BOARD ${board_line#BOARD }"
    echo "TRANSFER tx_hash=$tx_hash prime=$prime amount_micro_units=$amount fee_micro_units=$fee nonce=$nonce sender=$sender_address receiver=$receiver_address"
    echo "BALANCE_CHECK role=sender before=$sender_before after=$sender_after expected_after=$expected_sender pass=$([ "$sender_after" -eq "$expected_sender" ] && echo 1 || echo 0)"
    echo "BALANCE_CHECK role=receiver before=$receiver_before after=$receiver_after expected_after=$expected_receiver pass=$([ "$receiver_after" -eq "$expected_receiver" ] && echo 1 || echo 0)"
    echo "FEE_POOL_CHECK before=$pool_before after=$pool_after expected_after=$expected_pool pass=$([ "$pool_after" -eq "$expected_pool" ] && echo 1 || echo 0)"
    echo "RESULT transaction-evidence $([ "$pass" -eq 1 ] && echo OK || echo FAIL)"
  } > "$output"

  cat "$output"
  echo "TRANSACTION_EVIDENCE_REPORT $output"
  rm -rf "$tmpdir"
  [ "$pass" -eq 1 ] || return 1
}

cmd_launch_summary() {
  local client="$default_client"
  local workdir=""
  local output=""
  local out_dir=""
  local validators=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --workdir) require_value "$1" "${2:-}"; workdir="$2"; shift 2 ;;
      --validator) require_value "$1" "${2:-}"; validators+=("$2"); shift 2 ;;
      --client) require_value "$1" "${2:-}"; client="$2"; shift 2 ;;
      --output) require_value "$1" "${2:-}"; output="$2"; shift 2 ;;
      --out-dir) require_value "$1" "${2:-}"; out_dir="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option: $1" ;;
    esac
  done

  [ -n "$workdir" ] || die "--workdir is required"
  [ "${#validators[@]}" -gt 0 ] || die "at least one --validator host:port is required"
  [ -x "$client" ] || die "client is not executable: $client"
  [ -d "$workdir" ] || die "workdir not found: $workdir"

  local chain="$workdir/data/chain.dat"
  [ -f "$chain" ] || die "record store not found: $chain"
  [ -n "$out_dir" ] || out_dir="$workdir/reports"
  if [ -z "$output" ]; then
    mkdir -p "$out_dir"
    output="$out_dir/launch-summary-$(date -u +%Y%m%dT%H%M%SZ).txt"
  else
    mkdir -p "$(dirname "$output")"
  fi

  local tmpdir
  tmpdir="$(mktemp -d)"

  "$client" sync-peer "$workdir" >"$tmpdir/sync.out" 2>"$tmpdir/sync.err" || {
    sed 's/^/  /' "$tmpdir/sync.err" >&2 || true
    die "sync-peer failed"
  }
  "$client" launch-report "$chain" >"$tmpdir/launch.out" 2>"$tmpdir/launch.err" || {
    sed 's/^/  /' "$tmpdir/launch.err" >&2 || true
    die "launch-report failed"
  }

  local doctor_args=(--client "$client")
  local validator
  for validator in "${validators[@]}"; do
    doctor_args+=(--validator "$validator")
  done
  if cmd_doctor_network "${doctor_args[@]}" >"$tmpdir/doctor.out" 2>"$tmpdir/doctor.err"; then
    :
  else
    cat "$tmpdir/doctor.out" >&2 || true
    sed 's/^/  /' "$tmpdir/doctor.err" >&2 || true
    die "doctor-network failed"
  fi

  local chain_line validator_state evidence_summary board_line policy_line fee_pool_line network_line
  chain_line="$(grep '^CHAIN ' "$tmpdir/launch.out")"
  validator_state="$(grep '^VALIDATOR_STATE ' "$tmpdir/launch.out")"
  evidence_summary="$(grep '^VALIDATOR_EVIDENCE_SUMMARY ' "$tmpdir/launch.out")"
  board_line="$(grep '^BOARD ' "$tmpdir/launch.out")"
  policy_line="$(grep '^ECONOMIC_POLICY ' "$tmpdir/launch.out")"
  fee_pool_line="$(grep '^VALIDATOR_FEE_POOL ' "$tmpdir/launch.out")"
  network_line="$(grep '^NETWORK_OK ' "$tmpdir/doctor.out")"

  {
    echo "PRIMECHAIN_LAUNCH_SUMMARY generated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "WORKDIR $workdir"
    echo "NETWORK ${network_line#NETWORK_OK }"
    echo "CHAIN ${chain_line#CHAIN }"
    echo "VALIDATOR_STATE ${validator_state#VALIDATOR_STATE }"
    echo "VALIDATOR_EVIDENCE_SUMMARY ${evidence_summary#VALIDATOR_EVIDENCE_SUMMARY }"
    echo "ECONOMICS ${policy_line#ECONOMIC_POLICY } ${fee_pool_line#VALIDATOR_FEE_POOL }"
    echo "BOARD ${board_line#BOARD }"
    while read -r _ address rest; do
      [ -n "${address:-}" ] || continue
      local endpoint reserve evidence endpoint_display reserve_display evidence_display
      endpoint="$(grep "^VALIDATOR_ENDPOINT $address " "$tmpdir/launch.out" || true)"
      reserve="$(grep "^VALIDATOR_RESERVE_SUMMARY $address " "$tmpdir/launch.out" || true)"
      evidence="$(grep "^VALIDATOR_EVIDENCE $address " "$tmpdir/launch.out" || true)"
      endpoint_display="missing_endpoint=1"
      if [ -n "$endpoint" ]; then endpoint_display="${endpoint#VALIDATOR_ENDPOINT $address }"; fi
      reserve_display="missing_reserve=1"
      if [ -n "$reserve" ]; then reserve_display="${reserve#VALIDATOR_RESERVE_SUMMARY $address }"; fi
      evidence_display="missing_evidence=1"
      if [ -n "$evidence" ]; then evidence_display="${evidence#VALIDATOR_EVIDENCE $address }"; fi
      echo "VALIDATOR $address $reserve_display $endpoint_display $evidence_display"
    done < <(grep '^VALIDATOR_RESERVE_SUMMARY ' "$tmpdir/launch.out")
  } > "$output"

  cat "$output"
  echo "LAUNCH_SUMMARY_REPORT $output"
  rm -rf "$tmpdir"
}

main() {
  [ "$#" -gt 0 ] || { usage; exit 1; }
  local cmd="$1"
  shift
  case "$cmd" in
    install-validator-service) cmd_install_or_print install "$@" ;;
    print-validator-service) cmd_install_or_print print "$@" ;;
    doctor-validator) cmd_doctor "$@" ;;
    doctor-network) cmd_doctor_network "$@" ;;
    evidence) cmd_evidence "$@" ;;
    launch-summary) cmd_launch_summary "$@" ;;
    transaction-evidence) cmd_transaction_evidence "$@" ;;
    fee-distribution-status) cmd_fee_distribution_status "$@" ;;
    launch-status-json) cmd_launch_status_json "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $cmd" ;;
  esac
}

main "$@"
